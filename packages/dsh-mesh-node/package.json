    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "selfsigned": "^3.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "@modelcontextprotocol/client": "^2.3.1"
  },
  "devDependencies": {},
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinYanZhi/dsh-mesh.git"
  },
  "homepage": "https://github.com/LinYanZhi/dsh-mesh#readme",
  "bugs": {
    "url": "https://github.com/LinYanZhi/dsh-mesh/issues"
  },
  "scripts": {
    "serve": "node src/cli.js serve",
    "selftest": "node src/selftest.js",
    "test": "node src/selftest.js"
  }
